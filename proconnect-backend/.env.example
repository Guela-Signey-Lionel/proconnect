# ProConnect backend — example environment file
# Copy to .env and adapt the values:
#   cp .env.example .env
# When running with docker compose, use the service names (db, redis, rabbitmq, minio, mailpit) as hosts.
# When running locally with `mvn spring-boot:run`, use localhost defaults (see application.yml).

# --- Spring ---
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# --- Database (docker compose publishes the project Postgres on host port 5434,
#     because 5432 is the system PostgreSQL on this machine) ---
DATABASE_URL=jdbc:postgresql://localhost:5434/proconnect-db
DATABASE_USERNAME=proconnect
DATABASE_PASSWORD=proconnect

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- RabbitMQ ---
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# --- Mail (set to mailpit + 1025 when using the docker-compose stack) ---
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_USERNAME=
EMAIL_PASSWORD=

# --- JWT ---
# Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret-value-in-production
JWT_ACCESS_TTL_MINUTES=30
JWT_REFRESH_TTL_DAYS=7

# --- File storage (MinIO) ---
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=proconnect
STORAGE_PUBLIC_BASE_URL=http://192.168.48.35:9000

# --- Uploads limits ---
MAX_IMAGE_SIZE_MB=5
MAX_DOCUMENT_SIZE_MB=20
MAX_VIDEO_SIZE_MB=100

# --- CORS (comma-separated frontend origins) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://192.168.48.35:3000

# --- Google SSO (optional) ---
GOOGLE_CLIENT_ID=
